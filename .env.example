# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# ── Google Gemini API ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here

# ── OpenAI API (optional, if you want to support OpenAI as an alternative) ───
# OPENAI_API_KEY=your_openai_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
APP_DEBUG=false
